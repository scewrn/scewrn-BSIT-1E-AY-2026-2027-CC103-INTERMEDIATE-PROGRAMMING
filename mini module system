# SECTION 1: TRIGONOMETRIC (CIRCULAR) FUNCTIONS
def trig_menu():
    print_header("TRIGONOMETRIC (CIRCULAR) FUNCTIONS")
    print("""
1. sin(x)
2. cos(x)
3. tan(x)
4. Convert degrees <-> radians
0. Back to Main Menu
""")

    choice = safe_input("Enter your choice: ").strip()

    if choice == "1":
        deg = get_float("Enter angle in degrees: ")
        print(f"\n  sin({deg}) = {math.sin(math.radians(deg))}")

    elif choice == "2":
        deg = get_float("Enter angle in degrees: ")
        print(f"\n  cos({deg}) = {math.cos(math.radians(deg))}")

    elif choice == "3":
        deg = get_float("Enter angle in degrees: ")
        print(f"\n  tan({deg}) = {math.tan(math.radians(deg))}")

    elif choice == "4":
        deg = get_float("Enter a value in degrees: ")
        print(f"\n  {deg} degrees = {math.radians(deg)} radians")
        rad = get_float("Enter a value in radians: ")
        print(f"  {rad} radians = {math.degrees(rad)} degrees")

    elif choice == "0":
        return

    else:
        print("\nInvalid choice. Please try again.")

    pause()


